syntax = "v1"

info (
	title:   "Transhome API"
	desc:    "Website Transhome Muka 1: Katalog & Membership"
	version: "v1"
)

// =====================================================================
// Aturan:
// - Setiap group di bawah menghasilkan folder internal/handler/<group>
//   dan internal/logic/<group>. Nama group = nama modul di internal/modules.
// - Type di file ini hanya untuk request/response HTTP (internal/types).
//   Input/output use case ada di modules/<modul>/application/dto.
// =====================================================================
// Public catalog responses match frontend/docs/FRONTEND_BUILD_PLAN.md.
// Field names intentionally use snake_case, unlike the admin API.
type PublicCategoryChild {
	ID       int64   `json:"id"`
	Name     string  `json:"name"`
	Slug     string  `json:"slug"`
	ImageURL *string `json:"image_url"`
}

type PublicCategoryItem {
	ID       int64                `json:"id"`
	Name     string               `json:"name"`
	Slug     string               `json:"slug"`
	ImageURL *string              `json:"image_url"`
	Children []PublicCategoryChild `json:"children,omitempty"`
}

type PublicCategoryListResponse {
	Data []PublicCategoryItem `json:"data"`
}

type PublicBrandCategory {
	Name string `json:"name"`
	Slug string `json:"slug"`
}

type PublicBrandItem {
	ID           int64                 `json:"id"`
	Name         string                `json:"name"`
	Slug         string                `json:"slug"`
	LogoURL      *string               `json:"logo_url"`
	ProductCount int64                 `json:"product_count"`
	ShowOnHome   bool                  `json:"show_on_home"`
	HomeOrder    *int                  `json:"home_order"`
	Categories   []PublicBrandCategory `json:"categories"`
}

type PublicBrandListResponse {
	Data []PublicBrandItem `json:"data"`
}

type PublicBrandResponse {
	Data PublicBrandItem `json:"data"`
}

type PublicRoomItem {
	ID           int64  `json:"id"`
	Name         string `json:"name"`
	Slug         string `json:"slug"`
	ImageCover   string `json:"image_cover"`
	ProductCount int64  `json:"product_count"`
}

type PublicRoomListResponse {
	Data []PublicRoomItem `json:"data"`
}

type PublicRoomResponse {
	Data PublicRoomItem `json:"data"`
}

// Public catalog: GET /products returns { data: [...], meta: {...} }.
// Go handlers construct the JSON response. These types document the contract.
type PublicProductReference {
	ID int64 `json:"id"`
	Name string `json:"name"`
	Slug string `json:"slug"`
}

type PublicProductCategory {
	ID int64 `json:"id"`
	Name string `json:"name"`
	Slug string `json:"slug"`
	ParentID *int64 `json:"parent_id"`
	Parent *PublicProductReference `json:"parent,omitempty"`
}

type PublicProductImage {
	ID int64 `json:"id"`
	ProductID int64 `json:"product_id"`
	ImageURL string `json:"image_url"`
	IsPrimary bool `json:"is_primary"`
	SortOrder int `json:"sort_order"`
}

type PublicProductItem {
	ID int64 `json:"id"`
	SKU string `json:"sku"`
	Name string `json:"name"`
	Slug string `json:"slug"`
	PriceGeneral float64 `json:"price_general"`
	ShowPrice bool `json:"show_price"`
	UnitSale string `json:"unit_sale"`
	MinOrder int64 `json:"min_order"`
	StockStatus string `json:"stock_status"`
	StockQtyLabel *string `json:"stock_qty_label"`
	IsFeatured bool `json:"is_featured"`
	Brand *PublicProductReference `json:"brand"`
	Category *PublicProductCategory `json:"category"`
	PrimaryImageURL *string `json:"primary_image_url"`
}

type PublicProductFacetOption {
	Slug string `json:"slug"`
	Name string `json:"name"`
	Count int `json:"count"`
}

type PublicProductStockOption {
	Value string `json:"value"`
	Count int `json:"count"`
}

type PublicProductAttributeValue {
	Value string `json:"value"`
	Count int `json:"count"`
}

type PublicProductAttributeGroup {
	Key string `json:"key"`
	Values []PublicProductAttributeValue `json:"values"`
}

type PublicProductPriceRange {
	Min float64 `json:"min"`
	Max float64 `json:"max"`
}

type PublicProductFacets {
	Brands []PublicProductFacetOption `json:"brands"`
	Stock []PublicProductStockOption `json:"stock"`
	Rooms []PublicProductFacetOption `json:"rooms"`
	Attributes []PublicProductAttributeGroup `json:"attributes"`
	Price *PublicProductPriceRange `json:"price"`
}

type PublicProductMeta {
	Page int `json:"page"`
	PerPage int `json:"per_page"`
	Total int `json:"total"`
	TotalPages int `json:"total_pages"`
	Facets PublicProductFacets `json:"facets"`
}

type PublicProductsResponse {
	Data []PublicProductItem `json:"data"`
	Meta PublicProductMeta `json:"meta"`
}

type PublicProductDetail {
	ID int64 `json:"id"`
	SKU string `json:"sku"`
	Name string `json:"name"`
	Slug string `json:"slug"`
	PriceGeneral float64 `json:"price_general"`
	ShowPrice bool `json:"show_price"`
	UnitSale string `json:"unit_sale"`
	MinOrder int64 `json:"min_order"`
	StockStatus string `json:"stock_status"`
	StockQtyLabel *string `json:"stock_qty_label"`
	IsFeatured bool `json:"is_featured"`
	Brand *PublicProductReference `json:"brand"`
	Category *PublicProductCategory `json:"category"`
	PrimaryImageURL *string `json:"primary_image_url"`
	Description string `json:"description"`
	Specifications map[string]string `json:"specifications"`
	DatasheetPDFURL *string `json:"datasheet_pdf_url"`
	MetaTitle *string `json:"meta_title"`
	MetaDescription *string `json:"meta_description"`
	Images []PublicProductImage `json:"images"`
	Rooms []PublicProductReference `json:"rooms"`
}

type PublicProductResponse {
	Data PublicProductDetail `json:"data"`
}

type PublicProductSuggestionItems {
	Products []PublicProductReference `json:"products"`
	Categories []PublicProductReference `json:"categories"`
	Brands []PublicProductReference `json:"brands"`
}

type PublicProductSuggestionsResponse {
	Data PublicProductSuggestionItems `json:"data"`
}

type HealthResp {
	Status   string `json:"status"`
	Database string `json:"database"`
}

type LoginRequest {
	Email    string `json:"email"`
	Password string `json:"password"`
}

type LoginResponse {
	AccessToken string `json:"accessToken"`
}

type AccessControlRole {
	ID          int64  `json:"id"`
	Code        string `json:"code"`
	Name        string `json:"name"`
	Description string `json:"description,omitempty"`
	IsActive    bool   `json:"isActive"`
}

type AccessControlMenu {
	ID        int64  `json:"id"`
	ParentID  int64  `json:"parentId,omitempty"`
	Name      string `json:"name"`
	Code      string `json:"code"`
	Route     string `json:"route,omitempty"`
	Icon      string `json:"icon,omitempty"`
	SortOrder int64  `json:"sortOrder"`
	IsActive  bool   `json:"isActive"`
}

type AccessControlPermission {
	ID          int64  `json:"id"`
	MenuID      int64  `json:"menuId"`
	Code        string `json:"code"`
	Action      string `json:"action"`
	Description string `json:"description,omitempty"`
}

type AccessControlCatalogResponse {
	Roles       []AccessControlRole       `json:"roles"`
	Menus       []AccessControlMenu       `json:"menus"`
	Permissions []AccessControlPermission `json:"permissions"`
}

type ReplaceUserRolesRequest {
	RoleIDs []int64 `json:"roleIds"`
}

type ReplaceRolePermissionsRequest {
	PermissionIDs []int64 `json:"permissionIds"`
}

type CreateRoleRequest {
	Code        string `json:"code"`
	Name        string `json:"name"`
	Description string `json:"description,omitempty"`
}

type UpdateRoleRequest {
	Name        string `json:"name"`
	Description string `json:"description,omitempty"`
	IsActive    bool   `json:"isActive"`
}

type AccessControlRoleAssignmentsResponse {
	RoleIDs []int64 `json:"roleIds"`
}

type AccessControlPermissionAssignmentsResponse {
	PermissionIDs []int64 `json:"permissionIds"`
}

type AccessControlUserResponse {
	ID       int64   `json:"id"`
	Email    string  `json:"email"`
	IsActive bool    `json:"isActive"`
	RoleIDs  []int64 `json:"roleIds"`
}

type AccessControlMutationResponse {
	Success bool `json:"success"`
}

type UserAccessResponse {
	Menus           []AccessControlMenu `json:"menus"`
	PermissionCodes []string            `json:"permissionCodes"`
}

type SearchAccessControlUsersRequest {
	Email string `form:"email"`
}

type CatalogCategory {
	ID        int64  `json:"id"`
	Name      string `json:"name"`
	Slug      string `json:"slug"`
	ParentID  *int64 `json:"parentId,omitempty"`
	ImageURL  string `json:"imageUrl,omitempty"`
	SortOrder int64  `json:"sortOrder"`
	IsActive  bool   `json:"isActive"`
}

type CatalogCategoryListResponse {
	Categories []CatalogCategory `json:"categories"`
}

type CreateCategoryRequest {
	Name      string `json:"name"`
	Slug      string `json:"slug"`
	ParentID  *int64 `json:"parentId,omitempty"`
	ImageURL  string `json:"imageUrl,omitempty"`
	SortOrder int64  `json:"sortOrder"`
}

type UpdateCategoryRequest {
	Name      *string `json:"name,omitempty"`
	Slug      *string `json:"slug,omitempty"`
	ParentID  *int64  `json:"parentId,omitempty"`
	ImageURL  *string `json:"imageUrl,omitempty"`
	SortOrder *int64  `json:"sortOrder,omitempty"`
	IsActive  *bool   `json:"isActive,omitempty"`
}

type CatalogBrand {
	ID       int64  `json:"id"`
	Name     string `json:"name"`
	Slug     string `json:"slug"`
	LogoURL  string `json:"logoUrl,omitempty"`
	IsActive bool   `json:"isActive"`
}

type CatalogBrandListResponse {
	Brands []CatalogBrand `json:"brands"`
}

type CreateBrandRequest {
	Name    string `json:"name"`
	Slug    string `json:"slug"`
	LogoURL string `json:"logoUrl,omitempty"`
}

type UpdateBrandRequest {
	Name     *string `json:"name,omitempty"`
	Slug     *string `json:"slug,omitempty"`
	LogoURL  *string `json:"logoUrl,omitempty"`
	IsActive *bool   `json:"isActive,omitempty"`
}

type CatalogRoom {
	ID         int64  `json:"id"`
	Name       string `json:"name"`
	Slug       string `json:"slug"`
	ImageCover string `json:"imageCover"`
	SortOrder  int64  `json:"sortOrder"`
	IsActive   bool   `json:"isActive"`
}

type CatalogRoomListResponse {
	Rooms []CatalogRoom `json:"rooms"`
}

type CreateRoomRequest {
	Name       string `json:"name"`
	Slug       string `json:"slug"`
	ImageCover string `json:"imageCover"`
	SortOrder  int64  `json:"sortOrder"`
}

type UpdateRoomRequest {
	Name       *string `json:"name,omitempty"`
	Slug       *string `json:"slug,omitempty"`
	ImageCover *string `json:"imageCover,omitempty"`
	SortOrder  *int64  `json:"sortOrder,omitempty"`
	IsActive   *bool   `json:"isActive,omitempty"`
}

type CatalogProduct {
	ID              int64   `json:"id"`
	SKU             string  `json:"sku"`
	Name            string  `json:"name"`
	Slug            string  `json:"slug"`
	CategoryID      int64   `json:"categoryId"`
	BrandID         *int64  `json:"brandId,omitempty"`
	Description     string  `json:"description,omitempty"`
	Specifications  string  `json:"specifications,omitempty"`
	DatasheetPDFURL string  `json:"datasheetPdfUrl,omitempty"`
	PriceGeneral    float64 `json:"priceGeneral"`
	UnitSale        string  `json:"unitSale"`
	MinOrder        int64   `json:"minOrder"`
	StockStatus     string  `json:"stockStatus"`
	StockQtyLabel   string  `json:"stockQtyLabel,omitempty"`
	IsFeatured      bool    `json:"isFeatured"`
	IsActive        bool    `json:"isActive"`
	MetaTitle       string  `json:"metaTitle,omitempty"`
	MetaDescription string  `json:"metaDescription,omitempty"`
}

type CatalogProductListResponse {
	Products []CatalogProduct `json:"products"`
}

type CreateProductRequest {
	SKU             string  `json:"sku"`
	Name            string  `json:"name"`
	Slug            string  `json:"slug"`
	CategoryID      int64   `json:"categoryId"`
	BrandID         *int64  `json:"brandId,omitempty"`
	Description     string  `json:"description,omitempty"`
	Specifications  string  `json:"specifications,omitempty"`
	DatasheetPDFURL string  `json:"datasheetPdfUrl,omitempty"`
	PriceGeneral    float64 `json:"priceGeneral"`
	UnitSale        string  `json:"unitSale"`
	MinOrder        int64   `json:"minOrder"`
	StockStatus     string  `json:"stockStatus"`
	StockQtyLabel   string  `json:"stockQtyLabel,omitempty"`
	IsFeatured      bool    `json:"isFeatured"`
	IsActive        bool    `json:"isActive"`
	MetaTitle       string  `json:"metaTitle,omitempty"`
	MetaDescription string  `json:"metaDescription,omitempty"`
}

type UpdateProductRequest {
	SKU             *string  `json:"sku,omitempty"`
	Name            *string  `json:"name,omitempty"`
	Slug            *string  `json:"slug,omitempty"`
	CategoryID      *int64   `json:"categoryId,omitempty"`
	BrandID         *int64   `json:"brandId,omitempty"`
	Description     *string  `json:"description,omitempty"`
	Specifications  *string  `json:"specifications,omitempty"`
	DatasheetPDFURL *string  `json:"datasheetPdfUrl,omitempty"`
	PriceGeneral    *float64 `json:"priceGeneral,omitempty"`
	UnitSale        *string  `json:"unitSale,omitempty"`
	MinOrder        *int64   `json:"minOrder,omitempty"`
	StockStatus     *string  `json:"stockStatus,omitempty"`
	StockQtyLabel   *string  `json:"stockQtyLabel,omitempty"`
	IsFeatured      *bool    `json:"isFeatured,omitempty"`
	IsActive        *bool    `json:"isActive,omitempty"`
	MetaTitle       *string  `json:"metaTitle,omitempty"`
	MetaDescription *string  `json:"metaDescription,omitempty"`
}

type ReplaceProductRoomsRequest {
	RoomIDs []int64 `json:"roomIds"`
}

type CatalogMutationResponse {
	Success bool `json:"success"`
}

// Public content, services and store settings (Tahap 3).
// URL parameters are read and validated by the handlers.
type PublicBannerItem {
    ID int64 `json:"id"`
    Title string `json:"title"`
    ImageURL string `json:"image_url"`
    LinkURL *string `json:"link_url"`
    Position string `json:"position"`
    StartAt *string `json:"start_at"`
    EndAt *string `json:"end_at"`
    Subtitle *string `json:"subtitle,omitempty"`
    VideoURL *string `json:"video_url,omitempty"`
    CTALabel *string `json:"cta_label,omitempty"`
    CTA2Label *string `json:"cta2_label,omitempty"`
    CTA2URL *string `json:"cta2_url,omitempty"`
}

type PublicBannerListResponse {
    Data []PublicBannerItem `json:"data"`
}

type PublicArticleItem {
    ID int64 `json:"id"`
    Type string `json:"type"`
    Title string `json:"title"`
    Slug string `json:"slug"`
    ThumbnailURL *string `json:"thumbnail_url"`
    Excerpt string `json:"excerpt"`
    PublishedAt *string `json:"published_at"`
}

type PublicArticleListMeta {
    Page int `json:"page"`
    PerPage int `json:"per_page"`
    Total int64 `json:"total"`
    TotalPages int `json:"total_pages"`
}

type PublicArticleListResponse {
    Data []PublicArticleItem `json:"data"`
    Meta PublicArticleListMeta `json:"meta"`
}

type PublicArticleDetail {
    ID int64 `json:"id"`
    Type string `json:"type"`
    Title string `json:"title"`
    Slug string `json:"slug"`
    ThumbnailURL *string `json:"thumbnail_url"`
    Excerpt string `json:"excerpt"`
    PublishedAt *string `json:"published_at"`
    Content string `json:"content"`
    Status string `json:"status"`
}

type PublicArticleDetailResponse {
    Data PublicArticleDetail `json:"data"`
}

type PublicServiceItem {
    ID int64 `json:"id"`
    Name string `json:"name"`
    Slug string `json:"slug"`
    Summary string `json:"summary"`
    ImageURL *string `json:"image_url"`
    ServiceArea *string `json:"service_area"`
}

type PublicServiceListResponse {
    Data []PublicServiceItem `json:"data"`
}

type PublicServiceCategory {
    Name string `json:"name"`
    Slug string `json:"slug"`
}

type PublicServiceDetail {
    ID int64 `json:"id"`
    Name string `json:"name"`
    Slug string `json:"slug"`
    Summary string `json:"summary"`
    ImageURL *string `json:"image_url"`
    ServiceArea *string `json:"service_area"`
    Description string `json:"description"`
    Categories []PublicServiceCategory `json:"categories"`
}

type PublicServiceDetailResponse {
    Data PublicServiceDetail `json:"data"`
}

type PublicStoreSettings {
    WANumber *string `json:"wa_number"`
    Address *string `json:"address"`
    OpeningHours *string `json:"opening_hours"`
    MapsURL *string `json:"maps_url"`
    PointRatioRupiah *int64 `json:"point_ratio_rupiah"`
    WATemplateProduct *string `json:"wa_template_product"`
    WATemplateCart *string `json:"wa_template_cart"`
    WATemplateCartItem *string `json:"wa_template_cart_item"`
}

type PublicStoreSettingsResponse {
    Data PublicStoreSettings `json:"data"`
}

@server (
	prefix: /api/v1
)
service transhome-api {
	@doc "Cek status server dan koneksi database"
	@handler HealthHandler
	get /health returns (HealthResp)

	@handler LoginHandler
	post /auth/login (LoginRequest) returns (LoginResponse)

	@handler CurrentUserAccessHandler
	get /auth/me/access returns (UserAccessResponse)

	@doc "Pohon kategori publik (hanya kategori aktif)"
	@handler PublicCategoriesHandler
	get /categories returns (PublicCategoryListResponse)

	@doc "Daftar merek publik, jumlah produk dan kategori utama"
	@handler PublicBrandsHandler
	get /brands returns (PublicBrandListResponse)

	@doc "Detail merek berdasarkan slug"
	@handler PublicBrandHandler
	get /brands/:slug returns (PublicBrandResponse)

	@doc "Daftar ruangan publik beserta jumlah produk"
	@handler PublicRoomsHandler
	get /rooms returns (PublicRoomListResponse)

	@doc "Detail ruangan berdasarkan slug"
	@handler PublicRoomHandler
	get /rooms/:slug returns (PublicRoomResponse)

	@doc "Autocomplete pencarian produk, kategori, dan brand; minimum dua karakter"
	@handler PublicProductSuggestHandler
	get /products/suggest returns (PublicProductSuggestionsResponse)

	@doc "Katalog publik dengan filter, sorting, pagination, dan facets"
	@handler PublicProductsHandler
	get /products returns (PublicProductsResponse)

	@doc "Detail produk publik, termasuk foto, spesifikasi, dan ruangan"
	@handler PublicProductHandler
	get /products/:slug returns (PublicProductResponse)

	@doc "Banner aktif pada rentang tayang (opsional ?position=HOME_HERO/HOME_SLIDER/HOME_SIDE)"
	@handler PublicBannersHandler
	get /banners returns (PublicBannerListResponse)

	@doc "Daftar artikel terbit; ?type=ARTIKEL,PROMO,EVENT&page=1&per_page=9"
	@handler PublicArticlesHandler
	get /articles returns (PublicArticleListResponse)

	@doc "Detail artikel terbit; pratinjau draf belum diimplementasikan"
	@handler PublicArticleHandler
	get /articles/:slug returns (PublicArticleDetailResponse)

	@doc "Daftar jasa aktif; ?category=slug-kategori&limit=3"
	@handler PublicServicesHandler
	get /services returns (PublicServiceListResponse)

	@doc "Detail jasa aktif"
	@handler PublicServiceHandler
	get /services/:slug returns (PublicServiceDetailResponse)

	@doc "Pengaturan toko yang boleh dibaca pengunjung"
	@handler PublicSettingsHandler
	get /settings/public returns (PublicStoreSettingsResponse)

	@handler CatalogCategoriesHandler
	get /admin/catalog/categories returns (CatalogCategoryListResponse)

	@handler CatalogCategoryHandler
	get /admin/catalog/categories/:categoryId returns (CatalogCategory)

	@handler CreateCatalogCategoryHandler
	post /admin/catalog/categories (CreateCategoryRequest) returns (CatalogCategory)

	@handler UpdateCatalogCategoryHandler
	patch /admin/catalog/categories/:categoryId (UpdateCategoryRequest) returns (CatalogCategory)

	@handler CatalogBrandsHandler
	get /admin/catalog/brands returns (CatalogBrandListResponse)

	@handler CatalogBrandHandler
	get /admin/catalog/brands/:brandId returns (CatalogBrand)

	@handler CreateCatalogBrandHandler
	post /admin/catalog/brands (CreateBrandRequest) returns (CatalogBrand)

	@handler UpdateCatalogBrandHandler
	patch /admin/catalog/brands/:brandId (UpdateBrandRequest) returns (CatalogBrand)

	@handler CatalogRoomsHandler
	get /admin/catalog/rooms returns (CatalogRoomListResponse)

	@handler CatalogRoomHandler
	get /admin/catalog/rooms/:roomId returns (CatalogRoom)

	@handler CreateCatalogRoomHandler
	post /admin/catalog/rooms (CreateRoomRequest) returns (CatalogRoom)

	@handler UpdateCatalogRoomHandler
	patch /admin/catalog/rooms/:roomId (UpdateRoomRequest) returns (CatalogRoom)

	@handler CatalogProductsHandler
	get /admin/catalog/products returns (CatalogProductListResponse)

	@handler CatalogProductHandler
	get /admin/catalog/products/:productId returns (CatalogProduct)

	@handler CreateCatalogProductHandler
	post /admin/catalog/products (CreateProductRequest) returns (CatalogProduct)

	@handler UpdateCatalogProductHandler
	patch /admin/catalog/products/:productId (UpdateProductRequest) returns (CatalogProduct)

	@handler ReplaceCatalogProductRoomsHandler
	put /admin/catalog/products/:productId/rooms (ReplaceProductRoomsRequest) returns (CatalogMutationResponse)

	@handler AccessControlCatalogHandler
	get /admin/access-control/catalog returns (AccessControlCatalogResponse)

	@handler SearchAccessControlUsersHandler
	get /admin/users (SearchAccessControlUsersRequest) returns (AccessControlUserResponse)

	@handler CreateRoleHandler
	post /admin/roles (CreateRoleRequest) returns (AccessControlRole)

	@handler UpdateRoleHandler
	put /admin/roles/:roleId (UpdateRoleRequest) returns (AccessControlMutationResponse)

	@handler UserRolesHandler
	get /admin/users/:userId/roles returns (AccessControlRoleAssignmentsResponse)

	@handler ReplaceUserRolesHandler
	put /admin/users/:userId/roles (ReplaceUserRolesRequest) returns (AccessControlMutationResponse)

	@handler RolePermissionsHandler
	get /admin/roles/:roleId/permissions returns (AccessControlPermissionAssignmentsResponse)

	@handler ReplaceRolePermissionsHandler
	put /admin/roles/:roleId/permissions (ReplaceRolePermissionsRequest) returns (AccessControlMutationResponse)
}

// Group berikut ditambahkan saat endpoint-nya mulai dibuat:
//   group: identityaccess  (login, register, lupa password, role, menu)
//   group: catalog         (produk, kategori, brand, ruangan)
//   group: membership      (profil member, poin)
//   group: content         (artikel, banner, pengaturan situs)
//   group: audit           (log aktivitas admin)
//   group: integration     (status sync Qontak)
// ===== Incremental API compatibility extension (7 Nov 2026) =====
// Rute di bawah didaftarkan manual oleh internal/handler/routes.go.
// PENTING: Jangan menjalankan `make gen`/`goctl api go` langsung: itu akan
// menimpa routes.go dan membuang registrasi handler extension.
// Sebelum regenerasi, definisikan tipe request/response dan seluruh handler
// ekstensi di spesifikasi goctl secara lengkap, lalu bandingkan hasil diff.
// Public: GET /auth/google/redirect, /auth/google/callback
// Auth: POST /auth/login, /admin/auth/login, /auth/logout
// Auth: GET /me, /me/points; PATCH /me, /me/consent; POST /me/password
// Membership admin: GET /admin/members, /admin/members/search, /admin/members/:id
// Membership admin: PATCH /admin/members/:id
// Poin admin: GET /admin/points, /admin/points/check-reference; POST /admin/points
// Admin konten: GET/POST /admin/banners; GET/PUT/PATCH /admin/banners/:id
// Admin konten: GET/POST /admin/articles; GET/PUT/PATCH /admin/articles/:id
// Admin konten: GET/POST /admin/services; GET/PUT/PATCH /admin/services/:id
// Settings: GET/PUT /admin/settings, /admin/settings/whatsapp-templates
// Audit log: GET /admin/activity-logs, /admin/activity-logs/options
// Katalog canonical: /admin/catalog/{products,brands,categories,rooms}
// Tambahan katalog: GET /admin/catalog/products/check-sku
// Tambahan katalog: PUT /admin/catalog/brands/home; DELETE /admin/catalog/brands/:id
// Detail kontrak response ada di PANDUAN_INTEGRASI.md dalam paket patch.