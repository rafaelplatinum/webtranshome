# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# PostgreSQL.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/transhome?sslmode=disable&search_path=crm_schema

# Mekari Qontak
QONTAK_BASE_URL=
QONTAK_API_TOKEN=

# Login Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT untuk sesi login
JWT_SECRET=ganti-dengan-string-acak-panjang

# OTP password reset / verifikasi nomor (isi dari secret manager dan gateway yang digunakan)
OTP_HMAC_SECRET=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_TOKEN=
