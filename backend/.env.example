# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.

# PostgreSQL. %22 = tanda kutip ganda, wajib karena nama schema huruf besar.
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/CRM_TH?sslmode=disable&search_path=%22CRM_Schema%22

# Mekari Qontak
QONTAK_BASE_URL=
