# Salin file ini menjadi .env. Jangan commit file .env.
# Hanya variabel berawalan VITE_ yang terbaca di browser, jadi jangan simpan rahasia di sini.

# Base URL REST API backend Go (lihat backend/etc/transhome-api.yaml).
VITE_API_BASE_URL=http://localhost:8888/api/v1

# true = semua service memakai data contoh di src/services/mock/ (selama endpoint backend belum ada).
VITE_USE_MOCK=true
